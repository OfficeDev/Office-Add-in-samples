{
  "name": "office-ribbon-visibility",
  "version": "1.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/OfficeDev/Office-Add-in-samples.git"
  },
  "license": "MIT",
  "config": {
    "app_to_debug": "excel",
    "app_type_to_debug": "desktop",
    "dev_server_port": 3000
  },
  "scripts": {
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "dev-server": "webpack serve --mode development",
    "lint": "office-addin-lint check",
    "lint:fix": "office-addin-lint fix",
    "prettier": "office-addin-lint prettier",
    "signin": "office-addin-dev-settings m365-account login",
    "signout": "office-addin-dev-settings m365-account logout",
    "start": "office-addin-debugging start manifest.json",
    "start:desktop": "office-addin-debugging start manifest.json desktop",
    "start:desktop:excel": "office-addin-debugging start manifest.json desktop --app excel",
    "start:desktop:word": "office-addin-debugging start manifest.json desktop --app word",
    "start:desktop:powerpoint": "office-addin-debugging start manifest.json desktop --app powerpoint",
    "stop": "office-addin-debugging stop manifest.json",
    "type-check": "tsc --noEmit",
    "validate": "office-addin-manifest validate manifest.json",
    "watch": "webpack --mode development --watch"
  },
  "dependencies": {
    "core-js": "^3.36.0",
    "regenerator-runtime": "^0.14.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.25.4",
    "@babel/preset-typescript": "^7.23.3",
    "@types/office-js": "^1.0.600",
    "@types/office-runtime": "^1.0.35",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "^14.0.0",
    "eslint-plugin-office-addins": "^4.0.3",
    "html-loader": "^5.0.0",
    "html-webpack-plugin": "^5.6.0",
    "office-addin-cli": "^2.0.3",
    "office-addin-debugging": "^6.0.3",
    "office-addin-dev-certs": "^2.0.3",
    "office-addin-lint": "^3.0.3",
    "office-addin-manifest": "^2.0.3",
    "office-addin-prettier-config": "^2.0.1",
    "typescript": "^5.4.2",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.4"
  },
  "overrides": {
    "tmp": ">=0.2.6",
    "qs": ">=6.15.2",
    "uuid": ">=11.1.1",
    "protobufjs": ">=8.0.2",
    "serialize-javascript": ">=7.0.5",
    "axios": ">=1.18.0",
    "adm-zip": ">=0.6.0",
    "websocket-driver": ">=0.7.5",
    "@hono/node-server": ">=2.0.5"
  },
  "prettier": "office-addin-prettier-config",
  "browserslist": [
    "last 2 versions",
    "ie 11"
  ]
}
