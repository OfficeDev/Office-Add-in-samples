{
  "name": "word-document-assembly",
  "version": "1.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/OfficeDev/Office-Add-in-samples.git",
    "directory": "Samples/word-document-assembly"
  },
  "license": "MIT",
  "config": {
    "app_to_debug": "word",
    "app_type_to_debug": "desktop",
    "dev_server_port": 3000
  },
  "scripts": {
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "dev-server": "webpack serve --mode development",
    "lint": "office-addin-lint check",
    "lint:fix": "office-addin-lint fix",
    "prettier": "office-addin-lint prettier",
    "type-check": "tsc --noEmit --strict --esModuleInterop --target es2020 --module esnext --moduleResolution node --types office-js --lib es2020,dom src/taskpane/taskpane.ts src/assembly/document-assembly.ts src/assembly/team.ts",
    "start": "office-addin-debugging start manifest.json desktop --app word",
    "stop": "office-addin-debugging stop manifest.json",
    "validate": "office-addin-manifest validate manifest.json",
    "watch": "webpack --mode development --watch"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-typescript": "^7.23.3",
    "@types/office-js": "^1.0.377",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "^14.0.0",
    "html-loader": "^5.0.0",
    "html-webpack-plugin": "^5.6.0",
    "office-addin-cli": "^2.0.9",
    "office-addin-debugging": "^7.0.1",
    "office-addin-dev-certs": "^2.0.9",
    "office-addin-lint": "^3.0.9",
    "office-addin-manifest": "^3.0.1",
    "office-addin-prettier-config": "^2.0.4",
    "typescript": "^5.4.2",
    "webpack": "^5.90.3",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^6.0.0"
  },
  "prettier": "office-addin-prettier-config"
}
