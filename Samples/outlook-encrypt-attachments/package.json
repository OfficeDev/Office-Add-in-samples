{
  "name": "outlook-encrypt-attachments",
  "version": "1.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/OfficeDev/Office-Add-in-samples.git"
  },
  "license": "MIT",
  "config": {
    "app_to_debug": "outlook",
    "app_type_to_debug": "desktop",
    "dev_server_port": 3000
  },
  "scripts": {
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "dev-server": "webpack serve --mode development",
    "signin": "office-addin-dev-settings m365-account login",
    "signout": "office-addin-dev-settings m365-account logout",
    "start": "office-addin-debugging start manifest.json",
    "start:xml": "office-addin-debugging start manifest-localhost.xml",
    "stop": "office-addin-debugging stop manifest.json",
    "stop:xml": "office-addin-debugging stop manifest-localhost.xml",
    "test": "node --test",
    "validate": "office-addin-manifest validate manifest.json",
    "validate:xml": "office-addin-manifest validate manifest-localhost.xml",
    "watch": "webpack --mode development --watch"
  },
  "devDependencies": {
    "copy-webpack-plugin": "^14.0.0",
    "office-addin-debugging": "^6.1.2",
    "office-addin-dev-certs": "^2.0.10",
    "office-addin-manifest": "^2.1.6",
    "webpack": "^5.105.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.4"
  }
}
